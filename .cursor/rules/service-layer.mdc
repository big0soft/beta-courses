- Use database transactions for test isolation

```php
// Good: Service test example
class CourseServiceTest extends TestCase
{
    public function test_can_create_course()
    {
        $instructor = User::factory()->instructor()->create();
        $data = [
            'title' => 'Test Course',
            'description' => 'Test Description',
        ];
        
        $course = $this->courseService->createCourse($data, $instructor);
        
        $this->assertInstanceOf(Course::class, $course);
        $this->assertEquals('Test Course', $course->title);
        $this->assertEquals($instructor->id, $course->instructor_id);
    }
}
