## State Management Patterns

### Local State Management
- Use useState for simple component state
- Use useReducer for complex state logic
- Implement proper state updates
- Avoid unnecessary re-renders

```tsx
// Good: Local state with useReducer
interface CourseFormState {
  title: string;
  description: string;
  price: number;
  sections: CourseSection[];
  isSubmitting: boolean;
  errors: Record<string, string>;
}

type CourseFormAction = 
  | { type: 'SET_FIELD'; field: string; value: any }
  | { type: 'SET_SECTIONS'; sections: CourseSection[] }
  | { type: 'SET_SUBMITTING'; submitting: boolean }
  | { type: 'SET_ERRORS'; errors: Record<string, string> };

const courseFormReducer = (state: CourseFormState, action: CourseFormAction): CourseFormState => {
  switch (action.type) {
    case 'SET_FIELD':
      return { ...state, [action.field]: action.value };
    case 'SET_SECTIONS':
      return { ...state, sections: action.sections };
    case 'SET_SUBMITTING':
      return { ...state, isSubmitting: action.submitting };
    case 'SET_ERRORS':
      return { ...state, errors: action.errors };
    default:
      return state;
  }
};

const CourseForm: React.FC = () => {
  const [state, dispatch] = useReducer(courseFormReducer, {
    title: '',
    description: '',
    price: 0,
    sections: [],
    isSubmitting: false,
    errors: {},
  });

  const updateField = useCallback((field: string, value: any) => {
    dispatch({ type: 'SET_FIELD', field, value });
  }, []);

  return (
    // Form JSX
  );
};
```

### Global State Management
- Use Inertia.js shared data for server state
