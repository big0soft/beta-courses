```tsx
// Good: Global state with Context
interface AppState {
  user: User | null;
  theme: 'light' | 'dark';
  language: string;
  notifications: Notification[];
}

interface AppContextType {
  state: AppState;
  dispatch: React.Dispatch<AppAction>;
}

const AppContext = createContext<AppContextType | null>(null);

export const useApp = () => {
  const context = useContext(AppContext);
  if (!context) {
    throw new Error('useApp must be used within AppProvider');
  }
  return context;
};

export const AppProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [state, dispatch] = useReducer(appReducer, initialState);
  
  return (
    <AppContext.Provider value={{ state, dispatch }}>
      {children}
    </AppContext.Provider>
  );
};
```

## Form Management

### Inertia.js Forms
- Use useForm hook for form state
- Implement proper validation handling
- Use optimistic updates when appropriate
- Handle form submission errors

```tsx
// Good: Inertia form with validation
const CourseForm: React.FC<CourseFormProps> = ({ course, onSuccess }) => {
  const { data, setData, post, processing, errors, reset } = useForm({
    title: course?.title || '',
    description: course?.description || '',
    price: course?.price || 0,
    status: course?.status || 'draft',
  });

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    
    const url = course ? `/courses/${course.id}` : '/courses';
    const method = course ? 'put' : 'post';
    
    router[method](url, data, {
      onSuccess: () => {
        onSuccess?.();
        reset();
      },
      onError: (errors) => {
        console.error('Form errors:', errors);
      },
    });
  };

  return (
    <form onSubmit={handleSubmit} className="space-y-4">
      <div>
        <Label htmlFor="title">Title</Label>
        <Input
          id="title"
          value={data.title}
          onChange={(e) => setData('title', e.target.value)}
          className={errors.title ? 'border-red-500' : ''}
        />
        {errors.title && <p className="text-red-500 text-sm">{errors.title}</p>}
      </div>
      
      <Button type="submit" disabled={processing}>
        {processing ? 'Saving...' : 'Save Course'}
      </Button>
    </form>
  );
};
```

### Form Validation
- Implement client-side validation
- Use validation libraries when appropriate
- Provide real-time feedback
- Handle server-side validation errors

```tsx
// Good: Form validation with real-time feedback
const useFormValidation = (data: any, rules: ValidationRules) => {
  const [errors, setErrors] = useState<Record<string, string>>({});
  const [touched, setTouched] = useState<Record<string, boolean>>({});

  const validateField = useCallback((field: string, value: any) => {
    const rule = rules[field];
    if (!rule) return;

    const error = rule(value);
    setErrors(prev => ({ ...prev, [field]: error }));
  }, [rules]);

  const handleBlur = useCallback((field: string) => {
    setTouched(prev => ({ ...prev, [field]: true }));
    validateField(field, data[field]);
  }, [data, validateField]);

  const handleChange = useCallback((field: string, value: any) => {
    if (touched[field]) {
      validateField(field, value);
    }
  }, [touched, validateField]);

  return { errors, touched, handleBlur, handleChange };
};
```

## Component Patterns

### Higher-Order Components
- Use HOCs for cross-cutting concerns
- Implement proper prop forwarding
- Use displayName for debugging
- Avoid HOC overuse

```tsx
// Good: HOC for authentication
const withAuth = <P extends object>(Component: React.ComponentType<P>) => {
  const AuthenticatedComponent = (props: P) => {
    const { user, isLoggedIn } = useAuth();
    
    if (!isLoggedIn) {
      return <LoginPrompt />;
    }
    
    return <Component {...props} user={user} />;
  };
  
  AuthenticatedComponent.displayName = `withAuth(${Component.displayName || Component.name})`;
  
  return AuthenticatedComponent;
};

// Usage
const ProtectedCourseForm = withAuth(CourseForm);
```

### Render Props
- Use render props for flexible component APIs
- Implement proper prop types
- Use children as function pattern
- Provide fallback values

```tsx
// Good: Render prop pattern
interface DataFetcherProps<T> {
  url: string;
  children: (data: { data: T | null; loading: boolean; error: string | null }) => React.ReactNode;
}

const DataFetcher = <T,>({ url, children }: DataFetcherProps<T>) => {
  const [data, setData] = useState<T | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    fetch(url)
      .then(res => res.json())
      .then(setData)
      .catch(err => setError(err.message))
      .finally(() => setLoading(false));
  }, [url]);

  return <>{children({ data, loading, error })}</>;
};

// Usage
<DataFetcher<Course[]> url="/api/courses">
  {({ data, loading, error }) => {
    if (loading) return <div>Loading...</div>;
    if (error) return <div>Error: {error}</div>;
    return <CourseGrid courses={data || []} />;
  }}
</DataFetcher>
```

## Custom Hooks

### Data Fetching Hooks
- Create hooks for data fetching
- Implement proper loading states
- Handle errors appropriately
- Use caching when appropriate

```tsx
// Good: Data fetching hook
export const useCourses = (filters?: CourseFilters) => {
  const [courses, setCourses] = useState<Course[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    const fetchCourses = async () => {
      try {
        setLoading(true);
        const response = await fetch(`/api/courses?${new URLSearchParams(filters)}`);
        const data = await response.json();
        setCourses(data);
      } catch (err) {
        setError(err instanceof Error ? err.message : 'Failed to fetch courses');
      } finally {
        setLoading(false);
      }
    };

    fetchCourses();
  }, [filters]);

  return { courses, loading, error, refetch: () => fetchCourses() };
};
```

### UI State Hooks
- Create hooks for UI state management
- Implement proper state updates
- Use callbacks for state changes
- Provide cleanup functions

```tsx
// Good: UI state hook
export const useModal = (initialOpen = false) => {
  const [isOpen, setIsOpen] = useState(initialOpen);
  const [data, setData] = useState<any>(null);

  const open = useCallback((modalData?: any) => {
    setData(modalData);
    setIsOpen(true);
  }, []);

  const close = useCallback(() => {
    setIsOpen(false);
    setData(null);
  }, []);

  const toggle = useCallback(() => {
    setIsOpen(prev => !prev);
  }, []);

  return { isOpen, data, open, close, toggle };
};
```

