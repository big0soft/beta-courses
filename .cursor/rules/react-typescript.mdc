# React & TypeScript Development Rules

## Component Architecture

### Component Organization
- Use functional components with hooks
- Follow single responsibility principle
- Create reusable, composable components
- Use proper TypeScript interfaces

```tsx
// Good: Well-structured component with TypeScript
interface CourseCardProps {
  course: Course;
  onEnroll?: (courseId: string) => void;
  className?: string;
}

export const CourseCard: React.FC<CourseCardProps> = ({ 
  course, 
  onEnroll, 
  className 
}) => {
  return (
    <div className={cn("course-card", className)}>
      {/* Component content */}
    </div>
  );
};
```

### Component Patterns
- Use compound components for complex UI
- Implement proper prop drilling alternatives
- Create custom hooks for shared logic
- Use React.memo for performance optimization

```tsx
// Good: Custom hook for shared logic
export const useCourseEnrollment = (courseId: string) => {
  const [isEnrolled, setIsEnrolled] = useState(false);
  const [isLoading, setIsLoading] = useState(false);

  const enroll = useCallback(async () => {
    setIsLoading(true);
    try {
      await router.post(`/courses/${courseId}/enroll`);
      setIsEnrolled(true);
    } catch (error) {
      // Handle error
    } finally {
      setIsLoading(false);
    }
  }, [courseId]);

  return { isEnrolled, isLoading, enroll };
};
```

## TypeScript Best Practices

### Type Definitions
- Create comprehensive interfaces for all data structures
- Use union types for variant data
- Implement proper generic constraints
- Use utility types when appropriate

```tsx
// Good: Comprehensive type definitions
interface User {
  id: string;
  name: string;
  email: string;
  role: 'admin' | 'instructor' | 'student';
  avatar?: string;
  created_at: string;
  updated_at: string;
}

interface Course {
  id: string;
  title: string;
  description: string;
  price: number;
  instructor: User;
  sections: CourseSection[];
  status: CourseStatus;
}

type CourseStatus = 'draft' | 'published' | 'archived';
```

### Type Safety
- Use strict TypeScript configuration
- Avoid `any` type usage
- Use type guards for runtime type checking
- Implement proper error handling types

```tsx
// Good: Type-safe error handling
interface ApiError {
  message: string;
  errors?: Record<string, string[]>;
  status: number;
}

const isApiError = (error: unknown): error is ApiError => {
  return typeof error === 'object' && error !== null && 'message' in error;
};
```

