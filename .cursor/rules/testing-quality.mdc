// Good: Integration test example
import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import { CourseForm } from '@/components/course-form';
import { rest } from 'msw';
import { setupServer } from 'msw/node';

const server = setupServer(
  rest.post('/api/courses', (req, res, ctx) => {
    return res(ctx.json({ id: '1', title: 'Test Course' }));
  })
);

beforeAll(() => server.listen());
afterEach(() => server.resetHandlers());
afterAll(() => server.close());

describe('CourseForm Integration', () => {
  it('should submit form and redirect on success', async () => {
    render(<CourseForm />);
    
    fireEvent.change(screen.getByLabelText('Title'), {
      target: { value: 'Test Course' }
    });
    fireEvent.change(screen.getByLabelText('Description'), {
      target: { value: 'Test Description' }
    });
    
    fireEvent.click(screen.getByRole('button', { name: 'Create Course' }));
    
    await waitFor(() => {
      expect(screen.getByText('Course created successfully')).toBeInTheDocument();
    });
  });
});
```

## Test Data Management

### Factory Patterns
- Create realistic test data
- Use factories for consistent data
- Implement data relationships
- Handle data cleanup

```php
// Good: Factory implementation
class CourseFactory extends Factory
{
    protected $model = Course::class;

    public function definition()
    {
        return [
            'title' => $this->faker->sentence(4),
            'description' => $this->faker->paragraphs(3, true),
            'price' => $this->faker->randomFloat(2, 0, 500),
            'status' => $this->faker->randomElement(['draft', 'published']),
            'instructor_id' => User::factory()->instructor(),
            'category_id' => Category::factory(),
        ];
    }

    public function published()
    {
        return $this->state(function (array $attributes) {
            return [
                'status' => 'published',
                'published_at' => $this->faker->dateTimeBetween('-1 year', 'now'),
            ];
        });
    }

    public function withSections($count = 3)
    {
        return $this->afterCreating(function (Course $course) use ($count) {
            CourseSection::factory()->count($count)->create([
                'course_id' => $course->id
            ]);
        });
    }
}
```

### Test Database
- Use separate test database
- Implement proper database seeding
- Use database transactions for isolation
- Handle database cleanup

```php
// Good: Test database setup
class TestCase extends BaseTestCase
{
    use RefreshDatabase;

    protected function setUp(): void
    {
        parent::setUp();
        
        // Seed test data
        $this->seed([
            CategorySeeder::class,
            UserSeeder::class,
        ]);
    }

    protected function tearDown(): void
    {
        // Clean up test data
        $this->artisan('migrate:rollback');
        parent::tearDown();
    }
}
```

## Mocking and Stubbing

### Service Mocking
- Mock external services
- Mock expensive operations
- Use proper mock assertions
- Handle mock cleanup

```php
// Good: Service mocking
class PaymentServiceTest extends TestCase
{
    public function test_processes_payment_successfully()
    {
        $mockPaymentGateway = $this->createMock(PaymentGatewayInterface::class);
        $mockPaymentGateway->expects($this->once())
            ->method('processPayment')
            ->willReturn(new PaymentResult(['status' => 'success']));
        
        $paymentService = new PaymentService($mockPaymentGateway);
        $result = $paymentService->processPayment(['amount' => 100]);
        
        $this->assertTrue($result->isSuccessful());
    }
}
```

### API Mocking
- Mock external API calls
- Use consistent mock data
- Handle different response scenarios
- Test error conditions

```tsx
// Good: API mocking
import { rest } from 'msw';
import { setupServer } from 'msw/node';

const server = setupServer(
  rest.get('/api/courses', (req, res, ctx) => {
    return res(ctx.json({
      data: [
        { id: '1', title: 'Test Course 1' },
        { id: '2', title: 'Test Course 2' },
      ]
    }));
  }),
  
  rest.post('/api/courses', (req, res, ctx) => {
    return res(ctx.json({ id: '3', title: 'New Course' }));
  }),
  
  rest.get('/api/courses/:id', (req, res, ctx) => {
    return res(ctx.json({ id: req.params.id, title: 'Test Course' }));
  })
);
```

## Performance Testing

### Load Testing
- Test application under load
- Monitor performance metrics
- Identify bottlenecks
- Test scalability

```php
// Good: Load test example
class CourseLoadTest extends TestCase
{
    public function test_course_list_performance()
    {
        Course::factory()->count(1000)->create();
        
        $startTime = microtime(true);
        
        $response = $this->get('/api/courses');
        
        $endTime = microtime(true);
        $executionTime = $endTime - $startTime;
        
        $response->assertStatus(200);
        $this->assertLessThan(1.0, $executionTime, 'Course list should load in under 1 second');
    }
}
```

### Memory Testing
- Monitor memory usage
- Test for memory leaks
- Optimize memory consumption
- Use proper cleanup

```php
// Good: Memory test example
class MemoryTest extends TestCase
{
    public function test_course_creation_memory_usage()
    {
        $initialMemory = memory_get_usage();
        
        for ($i = 0; $i < 100; $i++) {
            Course::factory()->create();
        }
        
        $finalMemory = memory_get_usage();
        $memoryUsed = $finalMemory - $initialMemory;
        
        $this->assertLessThan(50 * 1024 * 1024, $memoryUsed, 'Memory usage should be under 50MB');
    }
}
```

